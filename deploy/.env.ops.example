# Sprint 18 operations runtime environment template (non-secret values only)

KERNEL_MODE=LIVE
KERNEL_PHASE=PHASE_3
RUN_SOURCE=logicmonitor
RUN_TARGET=nautobot
RUN_PARITY_WINDOW=30d

SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=300

OPS_HEALTH_HOST=0.0.0.0
OPS_HEALTH_PORT=8088

# Optional API/runner endpoints
LOGICMONITOR_ACCOUNT=replace-account
LOGICMONITOR_BASE_URL=https://replace-account.logicmonitor.com/santaba/rest
ANSIBLE_EXECUTION_ENDPOINT=http://ansible-runner:9000
ANSIBLE_RUNNER_PATH=/app/runtime/ansible
NAUTOBOT_URL=https://nautobot.local
POSTGRES_DB=controlplane
POSTGRES_USER=controlplane
POSTGRES_PASSWORD=replace-password

# Secret values are injected from files by deploy/container_entrypoint.py
#   LOGICMONITOR_API_KEY
#   NAUTOBOT_TOKEN
#   POSTGRES_CONNECTION_STRING
